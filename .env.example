# ---------------------------------------------------------------------------
# NIFTY 50 Drawdown Alert System - Example Configuration
# Copy this file to .env and fill in real values. Never commit .env itself.
# ---------------------------------------------------------------------------

# --- Market Data Provider ---------------------------------------------------
# Which provider implementation to use. Currently supported: "yfinance"
MARKET_DATA_PROVIDER=yfinance
NIFTY_TICKER_SYMBOL=^NSEI

# --- Drawdown Thresholds ----------------------------------------------------
# Comma-separated list of percentage drawdown thresholds.
# The engine will also auto-extend in 5% increments beyond the max listed
# value if the market keeps falling (see docs/DESIGN.md).
DRAWDOWN_THRESHOLDS=10,15,20,25,30,35,40,45,50

# How far (in percentage points) the drawdown must recover BELOW a triggered
# threshold before that threshold is allowed to fire again ("re-arm buffer").
REARM_BUFFER_PCT=2.0

# --- Polling / Scheduling ---------------------------------------------------
# How often to poll the market data provider, in seconds, during market hours.
POLL_INTERVAL_SECONDS=60

# Maximum age (seconds) a price quote may have before it is considered stale
# and rejected.
MAX_PRICE_STALENESS_SECONDS=900

# --- Market Hours (IST) -----------------------------------------------------
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
MARKET_TIMEZONE=Asia/Kolkata
# Path to a JSON file listing NSE trading holidays (YYYY-MM-DD per line/array)
NSE_HOLIDAY_FILE=config/nse_holidays.json

# --- Persistence -------------------------------------------------------------
DATABASE_PATH=data/nifty_alerts.db

# --- Notification Channels --------------------------------------------------
# Toggle each channel independently.
ENABLE_TELEGRAM_NOTIFIER=true
ENABLE_EMAIL_NOTIFIER=false
ENABLE_SMS_NOTIFIER=false
ENABLE_PUSH_NOTIFIER=false

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@example.com

# SMS (stub - plug in provider like Twilio/MSG91)
SMS_PROVIDER_API_KEY=
SMS_TO_NUMBER=

# Push (stub - plug in provider like FCM/OneSignal)
PUSH_PROVIDER_API_KEY=
PUSH_TARGET_TOKEN=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
